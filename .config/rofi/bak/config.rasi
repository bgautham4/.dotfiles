/*
 * Minimal Rofi Theme
 * Palette: 4 colors
 */

configuration {
    modi: "drun,window,windowcd,ssh";
}

@theme "/dev/null"

* {
    /* Catppuccin Lavender */
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;

    /* Semantic mapping */
    bg-dark: @base;
    bg: @surface0;
    bg-sel: @lavender;
    fg: @text;
    fg-dark: @subtext0;

    spacing: 0;
    background-color: transparent;
    font: "Noto Sans Mono 12";
}

window {
    background-color: @bg-dark;
    border: 1px;
    border-color: @surface2;
}

mainbox {
    children: [inputbar, listview];
    spacing: 10px;
    padding: 10px;
}

inputbar {
    padding: 0 10px;
    children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
    enabled: true;
    text-color: @fg;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0 1ch 0 0;
    text-color: @fg;
}

entry {
    text-color: @fg;
    placeholder-color: @fg-dark;
}

case-indicator {
    text-color: @fg-dark;
}

listview {
    lines: 4;
    scrollbar: false;
    margin: 0 10px;
    border: 0;
    dynamic: true;
}

element {
    padding: 8px;
    margin: 2px 0;
    border-radius: 4px;
    background-color: @bg-dark;
    children: [element-icon, element-text];
}

element selected {
    background-color: @lavender;
}

element-icon {
    size: 2ch;
    padding: 5px;
}

element-icon selected {
    text-color: @crust;
}

element-text {
    background-color: transparent;
    text-color: @fg-dark;
}

element-text selected {
    background-color: transparent;
    text-color: @crust;
}

textbox {
    text-color: @fg;
}

message {
    padding: 10px;
    background-color: @bg;
    text-color: @fg;
}

/* Scrollbar styling */
scrollbar {
    width: 4px;
    border: 0;
    handle-color: @fg-dark;
    handle-width: 8px;
    padding: 0;
}
