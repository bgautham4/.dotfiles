configuration {
    modi: "drun,window,windowcd,ssh";
}

@import "catppuccin-mocha"

* {
    /* Base */
    background:                  @base;
    foreground:                  @text;
    lightbg:                     @surface0;
    lightfg:                     @subtext1;

    /* Accent */
    accent:                      @lavender;

    /* Normal */
    normal-background:           @background;
    normal-foreground:           @foreground;

    /* Selected */
    selected-normal-background:  @lavender;
    selected-normal-foreground:  @base;

    /* Active */
    active-background:           @lightbg;
    active-foreground:           @lavender;
    
    /* Active + Selected */
    selected-active-background:  @lavender;
    selected-active-foreground:  @base;

    /* Urgent (kept restrained) */
    urgent-background:           @background;
    urgent-foreground:           @red;
    selected-urgent-background:  @red;
    selected-urgent-foreground:  @base;

    /* Alternates */
    //alternate-normal-background: @lightbg;
    //alternate-normal-foreground: @foreground;
    //alternate-active-background: @lightbg;
    //alternate-active-foreground: @lavender;
    //alternate-urgent-background: @lightbg;
    //alternate-urgent-foreground: @red;

    /* UI */
    separatorcolor:              @surface2;
    border-color:                @surface2;
    background-color:            transparent;

    spacing:                     0;
    font:                        "Noto Sans Mono 12";
}

/* -------- Window -------- */
window {
    background-color: @background;
    border:           1px;
    border-color:     @border-color;
    border-radius:    8px;
}

/* -------- Layout -------- */
mainbox {
    padding:  12px;
    spacing:  10px;
    children: [inputbar, listview];
}

/* -------- Input -------- */
inputbar {
    padding:    6px 10px;
    background-color: @surface0;
    border-radius:    6px;
    children:   [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
    enabled: true;
    text-color: @lavender;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0 1ch 0 0;
    text-color: @lavender;
}

entry {
    text-color:        @foreground;
    cursor:            text;
    placeholder-color: @overlay1;
    placeholder:       "Search";
}

case-indicator {
    text-color: @lavender;
}

/* -------- List -------- */
listview {
    lines:       6;
    margin:      4px 6px;
    scrollbar:   false;
    border:      0;
    dynamic:     true;
}

/* -------- Elements -------- */
element {
    padding:        8px;
    margin:         2px 0;
    border-radius:  6px;
    background-color: transparent;
    children: [element-icon, element-text];
}

element alternate {
    background-color: @background;
}

element alternate normal {
    background-color: @background;
}

element active {
    border-color: @lavender;
}

element selected {
    background-color: @selected-normal-background;
}

element selected active {
    background-color: @selected-active-background;
    border-color:     transparent;
}

element-icon {
    background-color: transparent;
    size:             2ch;
    padding:          5px;
    cursor:           inherit;
    text-color:       inherit;
}

element-icon active {
    text-color: @lavender;
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

element-text selected {
    text-color: @selected-normal-foreground;
}

/* -------- Messages -------- */
textbox {
    text-color: @foreground;
}

message {
    padding:          10px;
    background-color: @surface0;
    border-radius:    6px;
    text-color:       @foreground;
}

/* -------- Scrollbar -------- */
scrollbar {
    width:        4px;
    padding:      0;
    handle-width: 8px;
    border:       0;
    handle-color: @lavender;
}
